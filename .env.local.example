# ─────────────────────────────────────────────────────────────────────────────
# nestguard-frontend — example environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# The publicly deployed marketing site URL.
# Used by src/app/login/page.tsx (onBack button) to navigate the user back to
# the marketing homepage instead of looping back to /login.
# Production: https://nestguard.ai
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# CORS — allow the marketing site to call any future API routes (e.g. a
# contact-form handler or embedded widget).
# Production: https://nestguard.ai
ALLOWED_ORIGIN=https://nestguard.ai
