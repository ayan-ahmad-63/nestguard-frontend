# Copy to .env.local and fill in.
NEXT_PUBLIC_API_URL=http://localhost:3000        # FastAPI backend
NEXT_PUBLIC_WS_URL=http://localhost:3000         # same host: Socket.IO is served by the backend
NEXT_PUBLIC_MARKETING_URL=https://nestguard.live # "back to site" link on the login page

# Must be IDENTICAL to JWT_SECRET in the backend .env. The route guard (src/proxy.ts) uses it to verify
# the session token; without it nobody is treated as signed in.
JWT_SECRET=

# Dev only: shows the "simulate thumb touch" buttons. The backend must also run with ENV=development
# and ENABLE_SIMULATE=true, otherwise it answers 404.
NEXT_PUBLIC_ENABLE_SIMULATE=false
